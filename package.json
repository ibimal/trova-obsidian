{
  "name": "trova-obsidian",
  "version": "0.1.3",
  "private": true,
  "description": "Obsidian plugin for Trova: Instant search, related notes and Ask, a Context basket and Vault care on one local index",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p . && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "lint": "eslint . && stylelint styles.css",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.14.4",
    "oxfmt": "0.79.0",
    "stylelint": "^18.1.0",
    "stylelint-config-recommended": "^19.1.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
