{
  "name": "trova-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin for Trova: Instant search, related notes and Ask, a Context basket and Vault care on one local index",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p . && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  }
}
