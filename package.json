{
  "name": "trova-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin for Trova: Instant search, related notes and Ask, a Context basket and Vault care on one local index",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p . && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  }
}
